#!/usr/bin/env bash
set -Eeuo pipefail

# CSU's current portal parameters were cross-checked against the live
# page/loadConfig response and these CSU-specific implementations:
#   https://github.com/barkure/CSU-Net-Portal
#   https://github.com/Muhe-nye/CSU-auto-login
#   https://github.com/Temparo/CSU-WIFI-AutoLogin

readonly CREDENTIAL_FILE="${CSU_AUTH_CREDENTIAL_FILE:-/etc/csu-campus-auth/credentials}"
readonly PORTAL_API="${CSU_AUTH_PORTAL_API:-https://10.1.1.1:802/eportal/portal}"
readonly ONLINE_CHECK_URL="${CSU_AUTH_ONLINE_CHECK_URL:-http://captive.apple.com/hotspot-detect.html}"
readonly ONLINE_CHECK_HOST="${CSU_AUTH_ONLINE_CHECK_HOST:-captive.apple.com}"
readonly ONLINE_CHECK_PORT="${CSU_AUTH_ONLINE_CHECK_PORT:-80}"
readonly ONLINE_CHECK_ADDRESS="${CSU_AUTH_ONLINE_CHECK_ADDRESS:-}"
readonly RUNTIME_DIR="${CSU_AUTH_RUNTIME_DIR:-/run/csu-campus-auth}"
readonly LOCK_FILE="${CSU_AUTH_LOCK_FILE:-${RUNTIME_DIR}/lock}"
readonly LAST_RECOVERY_FILE="${RUNTIME_DIR}/last-forced-recovery"
readonly RECOVERY_COOLDOWN_SECONDS=600
readonly LOG_TAG="csu-campus-auth"

log() {
    logger -t "${LOG_TAG}" -- "$*"
}

internet_is_online() {
    local user_ip="$1"
    local address="${ONLINE_CHECK_ADDRESS}"
    local body

    if [[ -z "${address}" ]]; then
        address="$(
            dig +time=3 +tries=1 +short \
                -b "${user_ip}" @10.1.1.1 "${ONLINE_CHECK_HOST}" A 2>/dev/null |
            grep -E '^[0-9]+(\.[0-9]+){3}$' |
            head -n 1
        )"
    fi
    [[ -n "${address}" ]] || return 1

    body="$(
        curl --noproxy '*' --fail --silent --show-error \
            --interface "${user_ip}" \
            --resolve "${ONLINE_CHECK_HOST}:${ONLINE_CHECK_PORT}:${address}" \
            --connect-timeout 4 --max-time 8 \
            "${ONLINE_CHECK_URL}" 2>/dev/null || true
    )"
    [[ "${body}" == *"<TITLE>Success</TITLE>"* &&
       "${body}" == *"<BODY>Success</BODY>"* ]]
}

wait_for_internet() {
    local user_ip="$1"
    local attempt
    for attempt in {1..6}; do
        internet_is_online "${user_ip}" && return 0
        (( attempt < 6 )) && sleep 5
    done
    return 1
}

campus_ipv4() {
    local ip_address
    ip_address="$(
        ip -4 -o address show scope global 2>/dev/null |
        awk '{
            if ($4 ~ /^100\./) {
                split($4, address, "/")
                print address[1]
                exit
            }
        }'
    )"
    [[ -n "${ip_address}" ]] || return 1
    printf '%s' "${ip_address}"
}

normalize_account() {
    local account="$1"
    account="${account#,0,}"

    case "${account}" in
        *@dx) account="${account%@dx}@telecomn" ;;
        *@lt) account="${account%@lt}@unicomn" ;;
        *@yd) account="${account%@yd}@cmccn" ;;
    esac

    printf ',0,%s' "${account}"
}

curl_config_escape() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//$'\t'/\\t}"
    value="${value//$'\r'/\\r}"
    value="${value//$'\n'/\\n}"
    printf '%s' "${value}"
}

portal_login() {
    local account="$1"
    local password="$2"
    local user_ip="$3"
    local escaped_account escaped_password now_ms

    escaped_account="$(curl_config_escape "${account}")"
    escaped_password="$(curl_config_escape "${password}")"
    now_ms="$(date +%s%3N)"

    {
        printf 'data-urlencode = "callback=csu_auth_login"\n'
        printf 'data-urlencode = "login_method=1"\n'
        printf 'data-urlencode = "user_account=%s"\n' "${escaped_account}"
        printf 'data-urlencode = "user_password=%s"\n' "${escaped_password}"
        printf 'data-urlencode = "wlan_user_ip=%s"\n' "${user_ip}"
        printf 'data-urlencode = "wlan_user_ipv6="\n'
        printf 'data-urlencode = "wlan_user_mac=000000000000"\n'
        printf 'data-urlencode = "wlan_ac_ip="\n'
        printf 'data-urlencode = "wlan_ac_name="\n'
        printf 'data-urlencode = "jsVersion=4.1.3"\n'
        printf 'data-urlencode = "terminal_type=1"\n'
        printf 'data-urlencode = "lang=zh-cn"\n'
        printf 'data-urlencode = "v=%s"\n' "${now_ms}"
    } | curl --noproxy '*' --insecure --silent --show-error \
        --interface "${user_ip}" \
        --connect-timeout 5 --max-time 20 --get --config - \
        "${PORTAL_API}/login" 2>/dev/null || true
}

portal_logout() {
    local user_ip="$1"
    {
        printf 'data-urlencode = "callback=csu_auth_logout"\n'
        printf 'data-urlencode = "login_method=1"\n'
        printf 'data-urlencode = "user_account=drcom"\n'
        printf 'data-urlencode = "user_password=123"\n'
        printf 'data-urlencode = "ac_logout=1"\n'
        printf 'data-urlencode = "register_mode=1"\n'
        printf 'data-urlencode = "wlan_user_ip=%s"\n' "${user_ip}"
        printf 'data-urlencode = "wlan_user_ipv6="\n'
        printf 'data-urlencode = "wlan_vlan_id=0"\n'
        printf 'data-urlencode = "wlan_user_mac=000000000000"\n'
        printf 'data-urlencode = "wlan_ac_ip="\n'
        printf 'data-urlencode = "wlan_ac_name="\n'
        printf 'data-urlencode = "jsVersion=4.1.3"\n'
    } | curl --noproxy '*' --insecure --silent --show-error \
        --interface "${user_ip}" \
        --connect-timeout 5 --max-time 20 --get --config - \
        "${PORTAL_API}/logout" 2>/dev/null || true
}

portal_succeeded() {
    local response="$1"
    [[ "${response}" =~ \"result\"[[:space:]]*:[[:space:]]*\"?(1|ok)\"? ]]
}

portal_logout_succeeded() {
    local response="$1"
    portal_succeeded "${response}" ||
        [[ "${response,,}" =~ success|成功 ]]
}

forced_recovery_is_available() {
    local last_recovery=0 now
    if [[ -r "${LAST_RECOVERY_FILE}" ]]; then
        read -r last_recovery < "${LAST_RECOVERY_FILE}" || last_recovery=0
    fi
    [[ "${last_recovery}" =~ ^[0-9]+$ ]] || last_recovery=0
    now="$(date +%s)"
    (( now - last_recovery >= RECOVERY_COOLDOWN_SECONDS ))
}

mark_forced_recovery() {
    date +%s > "${LAST_RECOVERY_FILE}"
}

main() {
    mkdir -p -- "${RUNTIME_DIR}"
    exec 9>"${LOCK_FILE}"
    flock --nonblock 9 || exit 0

    local user_ip
    user_ip="$(campus_ipv4 || true)"
    if [[ -z "${user_ip}" ]]; then
        log "No 100.x campus IPv4 address is available; will retry later."
        exit 0
    fi

    if internet_is_online "${user_ip}"; then
        log "Internet connectivity is already available; no login needed."
        exit 0
    fi

    if [[ ! -r "${CREDENTIAL_FILE}" ]]; then
        log "Credential file is missing or unreadable: ${CREDENTIAL_FILE}"
        exit 78
    fi

    local -a credentials=()
    mapfile -t credentials < "${CREDENTIAL_FILE}"
    local stored_account="${credentials[0]:-}"
    local password="${credentials[1]:-}"
    local account response

    if [[ -z "${stored_account}" || -z "${password}" ]]; then
        log "Credential file is incomplete."
        exit 78
    fi

    account="$(normalize_account "${stored_account}")"
    response="$(portal_login "${account}" "${password}" "${user_ip}")"

    if portal_succeeded "${response}"; then
        log "The CSU eportal API accepted the login request."
        if wait_for_internet "${user_ip}"; then
            unset password credentials
            log "Campus network login succeeded and Internet connectivity is available."
            exit 0
        fi
        log "The CSU eportal API accepted login, but Internet probes still failed."
    else
        log "The CSU eportal API rejected login or returned an unexpected response."
    fi

    if ! forced_recovery_is_available; then
        unset password credentials
        log "Forced portal recovery is in its ten-minute safety cooldown."
        exit 1
    fi

    mark_forced_recovery
    log "Trying one CSU eportal logout and login recovery cycle."
    response="$(portal_logout "${user_ip}")"
    if ! portal_logout_succeeded "${response}"; then
        log "The CSU eportal API did not confirm logout; continuing with one login retry."
    fi

    sleep 3
    response="$(portal_login "${account}" "${password}" "${user_ip}")"
    unset password credentials

    if ! portal_succeeded "${response}"; then
        log "The CSU eportal login retry was rejected or returned an unexpected response."
        exit 1
    fi

    if wait_for_internet "${user_ip}"; then
        log "Campus network recovered through the CSU eportal API."
        exit 0
    fi

    log "CSU eportal recovery completed, but Internet connectivity is still unavailable."
    exit 1
}

main "$@"
